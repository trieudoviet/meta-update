#!/usr/bin/env bash
# ╔════════════════════════════════════════════════════════════════╗
# ║  check-all-updates v2 — Kiểm tra & cập nhật phần mềm         ║
# ║  Tự phát hiện app mới · Update tuần tự an toàn               ║
# ║  Cron: 16:00 hàng ngày                                       ║
# ╚════════════════════════════════════════════════════════════════╝
#
# Cách dùng:
#   check-all-updates              # Kiểm tra tất cả
#   check-all-updates --quick      # Bỏ qua apt update (dùng cache)
#   check-all-updates --apply      # Kiểm tra + update tuần tự (an toàn)
#   check-all-updates --json       # Xuất JSON cho scripting
#   check-all-updates --apply --yes  # Update không hỏi xác nhận

set -uo pipefail

# ── Colors & Formatting ──────────────────────────────────────────
if [[ -t 1 ]]; then
    RED='\033[0;31m'    GREEN='\033[0;32m'   YELLOW='\033[1;33m'
    BLUE='\033[0;34m'   CYAN='\033[0;36m'    MAGENTA='\033[0;35m'
    BOLD='\033[1m'      DIM='\033[2m'        NC='\033[0m'
    CHECK='✅'  WARN='⚠️ '  CRIT='🔴'  INFO='ℹ️ '  ROCKET='🚀'  NEW='🆕'
    INTERACTIVE=true
else
    RED='' GREEN='' YELLOW='' BLUE='' CYAN='' MAGENTA=''
    BOLD='' DIM='' NC=''
    CHECK='[OK]'  WARN='[!!]'  CRIT='[CR]'  INFO='[ii]'  ROCKET='[>>]'  NEW='[++]'
    INTERACTIVE=false
fi

# ── Config ────────────────────────────────────────────────────────
REPORT_DIR="$HOME/.local/share/update-checker"
REPORT_FILE="$REPORT_DIR/report-$(date +%Y%m%d).md"
LATEST_REPORT="$REPORT_DIR/latest-report.md"
LOG_FILE="$REPORT_DIR/check.log"
UPDATE_LOG="$REPORT_DIR/update-$(date +%Y%m%d-%H%M%S).log"
QUICK_MODE=false
JSON_MODE=false
APPLY_MODE=false
YES_MODE=false

mkdir -p "$REPORT_DIR"

# ── Tracked App Lists (centralized) ──────────────────────────────
# APT: "display_name|package_name"
TRACKED_APT=(
    "Google Chrome|google-chrome-stable"
    "VS Code|code"
    "Cursor|cursor"
    "Codex Desktop|codex-desktop"
    "Codex Switcher|codex-switcher"
    "Zoom Workplace|zoom"
    "RustDesk|rustdesk"
    "Remmina|remmina"
    "GIMP|gimp"
    "FileZilla|filezilla"
    "Flameshot|flameshot"
    "Okular|okular"
    "Docker CE|docker-ce"
)

# Snap: package names
TRACKED_SNAP=("firefox" "discord" "telegram-desktop" "vlc" "bun-js" "snapd")

# CLI tools: "display_name|command|version_cmd|update_cmd|latest_source|latest_arg"
#   latest_source: "npm" or "gh"
TRACKED_CLI=(
    "Claude Code|claude|claude --version|claude update|npm|@anthropic-ai/claude-code"
    "Codex CLI|codex|codex --version|codex update|npm|@openai/codex"
    "uv|uv|uv --version|uv self update|gh|astral-sh/uv"
)

# GitHub upstream checks: "display_name|dpkg_name|gh_repo|update_action|auto"
# auto=1 means can auto-update, auto=0 means manual download
TRACKED_GITHUB=(
    "RustDesk|rustdesk|rustdesk/rustdesk|MANUAL:https://github.com/rustdesk/rustdesk/releases|0"
    "Flameshot (upstream)|flameshot|flameshot-org/flameshot|MANUAL:https://github.com/flameshot-org/flameshot/releases|0"
    "Codex Switcher|codex-switcher|Lampese/codex-switcher|update-codex-switcher|1"
)

# AppImage: "display_name|file_path|gh_repo|config_version_file|version_json_key"
TRACKED_APPIMAGE=(
    "Obsidian|$HOME/Apps/Obsidian.AppImage|obsidianmd/obsidian-releases|$HOME/.config/obsidian/obsidian.json|version"
)

# Standalone binaries to IGNORE in discovery (scripts, non-apps)
KNOWN_LOCAL_BIN=("claude" "codex" "uv" "uvx" "7zz" "winbox" "update-codex-switcher" "check-all-updates" "monthly-disk-audit" "nlm" "notebooklm-mcp" "websockets")

# ── Parse Args ────────────────────────────────────────────────────
for arg in "$@"; do
    case "$arg" in
        --quick) QUICK_MODE=true ;;
        --json)  JSON_MODE=true ;;
        --apply) APPLY_MODE=true ;;
        --yes)   YES_MODE=true ;;
        --help|-h)
            echo "Usage: check-all-updates [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --quick    Skip 'apt update' (use cached data)"
            echo "  --apply    Check + update sequentially (safe mode)"
            echo "  --yes      Skip confirmation prompts (use with --apply)"
            echo "  --json     Output JSON instead of table"
            echo ""
            echo "Examples:"
            echo "  check-all-updates              # Check only"
            echo "  check-all-updates --apply      # Check + update with prompts"
            echo "  check-all-updates --apply --yes # Check + auto-update all"
            exit 0
            ;;
    esac
done

# ── Counters ──────────────────────────────────────────────────────
declare -i CNT_OK=0 CNT_UPDATE=0 CNT_CRITICAL=0 CNT_UNKNOWN=0
declare -i CNT_DISCOVERED=0
declare -i UPD_SUCCESS=0 UPD_FAIL=0 UPD_SKIP=0

# ── Results Arrays ────────────────────────────────────────────────
# Format: "category|app|current|latest|status|action|auto"
# auto: 1=can auto-update, 0=manual, ""=N/A
declare -a RESULTS=()
declare -a ACTIONS_HIGH=()
declare -a ACTIONS_MED=()
declare -a DISCOVERED=()
declare -a UPDATE_LOG_ENTRIES=()

# ══════════════════════════════════════════════════════════════════
# HELPER FUNCTIONS
# ══════════════════════════════════════════════════════════════════

header() {
    echo ""
    echo -e "${BOLD}${CYAN}━━━ $1 ━━━${NC}"
}

# Compare two version strings (0=equal, 1=v1>v2, 2=v1<v2)
ver_cmp() {
    [[ "$1" == "$2" ]] && return 0
    local v1="${1#v}" v2="${2#v}"
    local higher
    higher=$(printf '%s\n%s' "$v1" "$v2" | sort -V | tail -1)
    [[ "$higher" == "$v1" ]] && return 1 || return 2
}

# Fetch latest release tag from GitHub
gh_latest() {
    local tag
    tag=$(curl -sL --connect-timeout 5 --max-time 10 \
        "https://api.github.com/repos/$1/releases/latest" 2>/dev/null \
        | grep -oP '"tag_name"\s*:\s*"\K[^"]+' | head -1)
    echo "${tag#v}"
}

# Fetch latest version from npm registry
npm_latest() {
    curl -sL --connect-timeout 5 --max-time 10 \
        "https://registry.npmjs.org/$1/latest" 2>/dev/null \
        | grep -oP '"version"\s*:\s*"\K[^"]+' | head -1
}

# Record a check result
record() {
    local cat="$1" app="$2" cur="$3" latest="$4" status="$5" action="${6:-}" auto="${7:-}"
    case "$status" in
        OK)       ((CNT_OK++)) ;;
        UPDATE)   ((CNT_UPDATE++)) ; [[ -n "$action" ]] && ACTIONS_MED+=("$action") ;;
        CRITICAL) ((CNT_CRITICAL++)) ; [[ -n "$action" ]] && ACTIONS_HIGH+=("$action") ;;
        *)        ((CNT_UNKNOWN++)) ;;
    esac
    RESULTS+=("${cat}|${app}|${cur}|${latest}|${status}|${action}|${auto}")
}

# Check app version and auto-classify severity
check_app() {
    local cat="$1" app="$2" current="$3" latest="$4" action="${5:-}" auto="${6:-1}"

    if [[ -z "$latest" || "$latest" == "null" ]]; then
        record "$cat" "$app" "$current" "?" "UNKNOWN" "" "$auto"
        return
    fi

    local cmp=0
    ver_cmp "$current" "$latest" || cmp=$?

    case $cmp in
        0|1) record "$cat" "$app" "$current" "$latest" "OK" "" "$auto" ;;
        2)
            local cur_major lat_major
            cur_major=$(echo "$current" | cut -d. -f1)
            lat_major=$(echo "$latest" | cut -d. -f1)
            if [[ "$cur_major" != "$lat_major" ]]; then
                record "$cat" "$app" "$current" "$latest" "CRITICAL" "$action" "$auto"
            else
                local cur_minor lat_minor gap
                cur_minor=$(echo "$current" | cut -d. -f2)
                lat_minor=$(echo "$latest" | cut -d. -f2)
                gap=$(( lat_minor - cur_minor )) 2>/dev/null || gap=0
                if (( gap >= 5 )); then
                    record "$cat" "$app" "$current" "$latest" "CRITICAL" "$action" "$auto"
                else
                    record "$cat" "$app" "$current" "$latest" "UPDATE" "$action" "$auto"
                fi
            fi
            ;;
    esac
}

# ══════════════════════════════════════════════════════════════════
# PHASE 1: APT Packages
# ══════════════════════════════════════════════════════════════════
check_apt() {
    header "APT Packages (.deb)"

    if [[ "$QUICK_MODE" == false ]]; then
        echo -e "  ${DIM}Đang chạy apt update...${NC}"
        sudo apt update -qq 2>/dev/null || echo -e "  ${YELLOW}Không thể chạy apt update (cần sudo). Dùng cache.${NC}"
    fi

    for entry in "${TRACKED_APT[@]}"; do
        local name="${entry%%|*}" pkg="${entry##*|}"
        local installed
        installed=$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null) || continue

        local upgradable
        upgradable=$(apt list --upgradable 2>/dev/null | grep "^${pkg}/" | grep -oP '\S+\s' | head -1 | tr -d ' ')

        if [[ -n "$upgradable" ]]; then
            check_app "APT" "$name" "$installed" "$upgradable" "sudo apt install --only-upgrade $pkg" "1"
        else
            record "APT" "$name" "$installed" "$installed" "OK" "" "1"
        fi
        echo -ne "  ${DIM}Checked $name${NC}\r"
    done
    echo -e "  ${DIM}                                        ${NC}\r"
}

# ══════════════════════════════════════════════════════════════════
# PHASE 2: Snap Packages
# ══════════════════════════════════════════════════════════════════
check_snap() {
    header "Snap Packages"
    command -v snap &>/dev/null || return

    local snap_updates
    snap_updates=$(snap refresh --list 2>/dev/null | tail -n +2) || true

    for pkg in "${TRACKED_SNAP[@]}"; do
        local installed
        installed=$(snap list "$pkg" 2>/dev/null | tail -1 | awk '{print $2}') || continue

        local pending
        pending=$(echo "$snap_updates" | grep "^${pkg}\s" | awk '{print $2}') || true

        if [[ -n "$pending" ]]; then
            check_app "Snap" "$pkg" "$installed" "$pending" "sudo snap refresh $pkg" "1"
        else
            record "Snap" "$pkg" "$installed" "$installed" "OK" "" "1"
        fi
    done
}

# ══════════════════════════════════════════════════════════════════
# PHASE 3: GitHub Releases (upstream comparison)
# ══════════════════════════════════════════════════════════════════
check_github() {
    header "GitHub Releases (upstream)"

    for entry in "${TRACKED_GITHUB[@]}"; do
        IFS='|' read -r name dpkg_name gh_repo action auto <<< "$entry"
        local cur
        cur=$(dpkg-query -W -f='${Version}' "$dpkg_name" 2>/dev/null | grep -oP '^\d+\.\d+[\.\d]*') || continue
        local latest
        latest=$(gh_latest "$gh_repo")
        check_app "GitHub" "$name" "$cur" "$latest" "$action" "$auto"
        echo -ne "  ${DIM}Checked $name${NC}\r"
    done

    # AppImage checks
    for entry in "${TRACKED_APPIMAGE[@]}"; do
        IFS='|' read -r name filepath gh_repo config_file ver_key <<< "$entry"
        [[ -f "$filepath" ]] || continue
        local latest cur="?"
        latest=$(gh_latest "$gh_repo")
        if [[ -f "$config_file" ]]; then
            cur=$(grep -oP "\"${ver_key}\"\\s*:\\s*\"\\K[^\"]+" "$config_file" 2>/dev/null | head -1) || cur="?"
        fi
        if [[ "$cur" == "?" || -z "$cur" ]]; then
            record "AppImage" "$name" "?" "${latest:-?}" "UNKNOWN" "MANUAL:Mở app → Settings → About" "0"
        else
            check_app "AppImage" "$name" "$cur" "$latest" "MANUAL:Tải mới từ https://obsidian.md/download" "0"
        fi
        echo -ne "  ${DIM}Checked $name${NC}\r"
    done

    echo -e "  ${DIM}                                        ${NC}\r"
}

# ══════════════════════════════════════════════════════════════════
# PHASE 4: CLI Tools
# ══════════════════════════════════════════════════════════════════
check_cli_tools() {
    header "CLI Tools"

    for entry in "${TRACKED_CLI[@]}"; do
        IFS='|' read -r name cmd ver_cmd upd_cmd src src_arg <<< "$entry"
        command -v "$cmd" &>/dev/null || continue

        local cur
        cur=$($ver_cmd 2>/dev/null | grep -oP '[\d.]+' | head -1) || continue
        [[ -z "$cur" ]] && continue

        local latest=""
        case "$src" in
            npm) latest=$(npm_latest "$src_arg") ;;
            gh)  latest=$(gh_latest "$src_arg") ;;
        esac

        check_app "CLI" "$name" "$cur" "$latest" "$upd_cmd" "1"
        echo -ne "  ${DIM}Checked $name${NC}\r"
    done

    echo -e "  ${DIM}                                        ${NC}\r"
}

# ══════════════════════════════════════════════════════════════════
# PHASE 5: AUTO-DISCOVER — Phát hiện app mới chưa theo dõi
# ══════════════════════════════════════════════════════════════════
discover_new_software() {
    header "Auto-Discovery (phần mềm mới)"

    # Build sets of tracked package names for quick lookup
    local -A tracked_apt_set tracked_snap_set tracked_bin_set

    for entry in "${TRACKED_APT[@]}"; do
        tracked_apt_set["${entry##*|}"]="1"
    done
    # Also add GitHub-tracked deb packages
    for entry in "${TRACKED_GITHUB[@]}"; do
        IFS='|' read -r _ dpkg_name _ _ _ <<< "$entry"
        tracked_apt_set["$dpkg_name"]="1"
    done

    for pkg in "${TRACKED_SNAP[@]}"; do
        tracked_snap_set["$pkg"]="1"
    done

    for name in "${KNOWN_LOCAL_BIN[@]}"; do
        tracked_bin_set["$name"]="1"
    done
    for entry in "${TRACKED_CLI[@]}"; do
        IFS='|' read -r _ cmd _ _ _ _ <<< "$entry"
        tracked_bin_set["$cmd"]="1"
    done

    # ── Discover new APT desktop apps ─────────────────────────────
    local found_apt=0
    # Find .desktop files that point to installed deb packages
    while IFS= read -r desktop_file; do
        [[ -f "$desktop_file" ]] || continue
        # Skip NoDisplay=true entries
        grep -qi '^NoDisplay=true' "$desktop_file" 2>/dev/null && continue
        # Skip GNOME settings panels, handlers, etc.
        grep -qi 'gnome-control-center\|xdg-desktop-portal\|ibus\|fcitx\|im-config' "$desktop_file" 2>/dev/null && continue
        # Get the package owning this file
        local pkg
        pkg=$(dpkg -S "$desktop_file" 2>/dev/null | cut -d: -f1 | head -1) || continue
        [[ -z "$pkg" ]] && continue
        # Skip if already tracked
        [[ -n "${tracked_apt_set[$pkg]:-}" ]] && continue
        # Skip libs, meta-packages, system utilities, GNOME built-in apps
        [[ "$pkg" =~ ^(lib|gnome-|ubuntu-|yaru-|xdg-|im-|ibus|snap|language-|aspell) ]] && continue
        # Skip pre-installed Ubuntu desktop apps (not worth tracking individually)
        local -a SKIP_BUILTIN=(apport-gtk baobab cheese eog evince evince-common file-roller gnome-calculator gnome-calendar gnome-characters gnome-clocks gnome-connections gnome-disk-utility gnome-font-viewer gnome-logs gnome-power-manager gnome-system-monitor gnome-text-editor gnome-tweaks gnome-weather loupe seahorse simple-scan snap-store software-properties-gtk totem transmission-gtk update-manager yelp nautilus vim-common xterm info network-manager-gnome drawing chrome-remote-desktop imagemagick-6.q16)
        local is_builtin=false
        for skip in "${SKIP_BUILTIN[@]}"; do [[ "$pkg" == "$skip" ]] && is_builtin=true && break; done
        [[ "$is_builtin" == true ]] && continue
        # Get app name
        local app_name
        app_name=$(grep '^Name=' "$desktop_file" 2>/dev/null | head -1 | cut -d= -f2-) || continue
        [[ -z "$app_name" ]] && continue
        # Skip duplicates
        local already=false
        for d in "${DISCOVERED[@]+"${DISCOVERED[@]}"}"; do
            [[ "$d" == *"|$pkg|"* ]] && already=true && break
        done
        [[ "$already" == true ]] && continue

        local ver
        ver=$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null) || ver="?"
        DISCOVERED+=("APT|$pkg|$app_name|$ver")
        ((found_apt++))
        tracked_apt_set["$pkg"]="1"  # prevent further duplicates
    done < <(find /usr/share/applications -maxdepth 1 -name "*.desktop" 2>/dev/null | sort)

    # ── Discover new user-installed .desktop apps ─────────────────
    while IFS= read -r desktop_file; do
        [[ -f "$desktop_file" ]] || continue
        grep -qi '^NoDisplay=true' "$desktop_file" 2>/dev/null && continue
        local app_name exec_line
        app_name=$(grep '^Name=' "$desktop_file" 2>/dev/null | head -1 | cut -d= -f2-) || continue
        exec_line=$(grep '^Exec=' "$desktop_file" 2>/dev/null | head -1 | cut -d= -f2-) || continue
        [[ -z "$app_name" || -z "$exec_line" ]] && continue
        # Check if it's a Chrome PWA (already known)
        [[ "$desktop_file" =~ chrome- ]] && continue
        # Check if it's tracked AppImage
        local is_tracked=false
        for entry in "${TRACKED_APPIMAGE[@]}"; do
            [[ "$exec_line" == *"$(echo "$entry" | cut -d'|' -f2 | xargs basename)"* ]] && is_tracked=true && break
        done
        [[ "$is_tracked" == true ]] && continue
        # Check if it links to a tracked deb package
        local first_cmd
        first_cmd=$(echo "$exec_line" | awk '{print $1}')
        local pkg_owner
        pkg_owner=$(dpkg -S "$first_cmd" 2>/dev/null | cut -d: -f1 | head -1) || pkg_owner=""
        [[ -n "$pkg_owner" && -n "${tracked_apt_set[$pkg_owner]:-}" ]] && continue

        local already=false
        for d in "${DISCOVERED[@]+"${DISCOVERED[@]}"}"; do
            [[ "$d" == *"|$app_name|"* ]] && already=true && break
        done
        [[ "$already" == true ]] && continue

        DISCOVERED+=("Local|$app_name|$app_name|via .desktop")
    done < <(find "$HOME/.local/share/applications" -maxdepth 1 -name "*.desktop" 2>/dev/null | sort)

    # ── Discover new Snap apps ────────────────────────────────────
    while IFS= read -r line; do
        local pkg
        pkg=$(echo "$line" | awk '{print $1}')
        [[ -z "$pkg" || "$pkg" == "Name" ]] && continue
        # Skip base/core snaps
        [[ "$pkg" =~ ^(bare|core|gnome-|gtk-|mesa-|snapd-desktop|firmware-updater|snap-store) ]] && continue
        [[ -n "${tracked_snap_set[$pkg]:-}" ]] && continue
        local ver
        ver=$(echo "$line" | awk '{print $2}')
        DISCOVERED+=("Snap|$pkg|$pkg|$ver")
    done < <(snap list 2>/dev/null | tail -n +2)

    # ── Discover new standalone binaries ──────────────────────────
    while IFS= read -r binfile; do
        local binname
        binname=$(basename "$binfile")
        [[ -n "${tracked_bin_set[$binname]:-}" ]] && continue
        # Skip symlinks to tracked tools, dotfiles, python shims
        [[ "$binname" =~ ^(\.|_|python|pip|node|npm|npx|corepack|pnpm|yarn|bun) ]] && continue
        # Verify it's executable
        [[ -x "$binfile" ]] || continue
        DISCOVERED+=("Binary|$binname|$binname|$(stat -c%s "$binfile" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo '?')")
    done < <(find "$HOME/.local/bin" -maxdepth 1 -type f 2>/dev/null; find "$HOME/.local/bin" -maxdepth 1 -type l 2>/dev/null)

    # ── Discover new AppImage files ───────────────────────────────
    local -A tracked_appimage_files
    for entry in "${TRACKED_APPIMAGE[@]}"; do
        local filepath
        filepath=$(echo "$entry" | cut -d'|' -f2)
        tracked_appimage_files["$(basename "$filepath")"]="1"
    done

    while IFS= read -r appimg; do
        local basename_ai
        basename_ai=$(basename "$appimg")
        [[ -n "${tracked_appimage_files[$basename_ai]:-}" ]] && continue
        DISCOVERED+=("AppImage|$basename_ai|$basename_ai|$(stat -c%s "$appimg" 2>/dev/null | numfmt --to=iec 2>/dev/null || echo '?')")
    done < <(find "$HOME/Apps" "$HOME/Applications" "$HOME/Desktop" -maxdepth 2 \( -name "*.AppImage" -o -name "*.appimage" \) 2>/dev/null)

    CNT_DISCOVERED=${#DISCOVERED[@]}
}

# ══════════════════════════════════════════════════════════════════
# DISPLAY: Print Results Table
# ══════════════════════════════════════════════════════════════════
print_table() {
    echo ""
    echo -e "${BOLD}╔══════════════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}║  ${ROCKET} Báo Cáo Kiểm Tra Cập Nhật — $(date '+%d/%m/%Y %H:%M')                        ║${NC}"
    echo -e "${BOLD}╚══════════════════════════════════════════════════════════════════════════╝${NC}"
    echo ""

    local total=$((CNT_OK + CNT_UPDATE + CNT_CRITICAL + CNT_UNKNOWN))
    echo -e "  ${GREEN}${CHECK} Mới nhất: ${CNT_OK}${NC}  ${YELLOW}${WARN}Có update: ${CNT_UPDATE}${NC}  ${RED}${CRIT} Lệch lớn: ${CNT_CRITICAL}${NC}  ${DIM}${INFO} Không rõ: ${CNT_UNKNOWN}${NC}  ${BLUE}${NEW} Phát hiện mới: ${CNT_DISCOVERED}${NC}  ${DIM}Tổng: ${total}${NC}"
    echo ""

    printf "  ${BOLD}%-10s %-24s %-18s %-18s %-6s${NC}\n" "Nguồn" "Phần mềm" "Hiện tại" "Mới nhất" "TT"
    echo -e "  ${DIM}────────────────────────────────────────────────────────────────────────────${NC}"

    local prev_cat=""
    for entry in "${RESULTS[@]}"; do
        IFS='|' read -r cat app cur latest status action auto <<< "$entry"
        if [[ "$cat" != "$prev_cat" && -n "$prev_cat" ]]; then
            echo -e "  ${DIM}··········································································${NC}"
        fi
        prev_cat="$cat"

        local icon color
        case "$status" in
            OK)       icon="$CHECK" ; color="$GREEN" ;;
            UPDATE)   icon="$WARN"  ; color="$YELLOW" ;;
            CRITICAL) icon="$CRIT"  ; color="$RED" ;;
            *)        icon="$INFO"  ; color="$DIM" ;;
        esac

        [[ ${#cur} -gt 16 ]] && cur="${cur:0:14}.."
        [[ ${#latest} -gt 16 ]] && latest="${latest:0:14}.."

        printf "  ${DIM}%-10s${NC} %-24s ${color}%-18s${NC} %-18s %s\n" \
            "$cat" "$app" "$cur" "$latest" "$icon"
    done

    # ── Discovered apps section ───────────────────────────────────
    if (( CNT_DISCOVERED > 0 )); then
        echo ""
        echo -e "  ${BOLD}${BLUE}┌─ ${NEW} Phần mềm phát hiện mới (chưa theo dõi) ────────────────────${NC}"
        printf "  ${BOLD}%-10s %-24s %-24s %-14s${NC}\n" "Nguồn" "Package/File" "Tên" "Version/Size"
        echo -e "  ${DIM}────────────────────────────────────────────────────────────────────────────${NC}"
        for d in "${DISCOVERED[@]}"; do
            IFS='|' read -r dcat dpkg dname dver <<< "$d"
            printf "  ${BLUE}%-10s${NC} %-24s %-24s %-14s\n" "$dcat" "$dpkg" "$dname" "$dver"
        done
        echo ""
        echo -e "  ${DIM}💡 Khuyến nghị: Thêm app mới vào checklist bằng cách sửa TRACKED_* trong script${NC}"
        echo -e "  ${DIM}   File: ~/.local/bin/check-all-updates${NC}"
    fi

    echo ""
}

# ══════════════════════════════════════════════════════════════════
# DISPLAY: Print Recommendations
# ══════════════════════════════════════════════════════════════════
print_recommendations() {
    if (( CNT_CRITICAL + CNT_UPDATE == 0 )); then
        echo -e "  ${GREEN}${BOLD}🎉 Tất cả phần mềm đều đã cập nhật! Không cần làm gì.${NC}"
        echo ""
        return
    fi

    echo -e "${BOLD}${RED}┌─ 🔴 Ưu tiên cao ────────────────────────────────────────────────${NC}"
    if (( ${#ACTIONS_HIGH[@]} > 0 )); then
        for act in "${ACTIONS_HIGH[@]}"; do
            if [[ "$act" == MANUAL:* ]]; then
                echo -e "  ${RED}▸${NC} ${DIM}[Thủ công]${NC} Tải từ: ${act#MANUAL:}"
            else
                echo -e "  ${RED}▸${NC} $act"
            fi
        done
    else
        echo -e "  ${GREEN}Không có${NC}"
    fi
    echo ""

    echo -e "${BOLD}${YELLOW}┌─ ⚠️  Ưu tiên trung bình ─────────────────────────────────────────${NC}"
    if (( ${#ACTIONS_MED[@]} > 0 )); then
        for act in "${ACTIONS_MED[@]}"; do
            if [[ "$act" == MANUAL:* ]]; then
                echo -e "  ${YELLOW}▸${NC} ${DIM}[Thủ công]${NC} Tải từ: ${act#MANUAL:}"
            else
                echo -e "  ${YELLOW}▸${NC} $act"
            fi
        done
    else
        echo -e "  ${GREEN}Không có${NC}"
    fi
    echo ""

    if (( CNT_CRITICAL + CNT_UPDATE > 0 )); then
        echo -e "${BOLD}${CYAN}┌─ 🚀 Quick Update ────────────────────────────────────────────────${NC}"
        echo ""

        local apt_pkgs=""
        local has_snap=false
        for entry in "${RESULTS[@]}"; do
            IFS='|' read -r cat app cur latest status action auto <<< "$entry"
            if [[ "$cat" == "APT" && ("$status" == "UPDATE" || "$status" == "CRITICAL") ]]; then
                local pkg
                pkg=$(echo "$action" | grep -oP 'install --only-upgrade \K\S+') || true
                [[ -n "$pkg" ]] && apt_pkgs+="$pkg "
            fi
            [[ "$cat" == "Snap" && ("$status" == "UPDATE" || "$status" == "CRITICAL") ]] && has_snap=true
        done

        echo -e "  ${DIM}# Copy & chạy, hoặc dùng: check-all-updates --apply${NC}"
        echo ""
        [[ -n "$apt_pkgs" ]] && echo -e "  sudo apt update && sudo apt install --only-upgrade ${apt_pkgs}"
        [[ "$has_snap" == true ]] && echo -e "  sudo snap refresh"

        for entry in "${RESULTS[@]}"; do
            IFS='|' read -r cat app cur latest status action auto <<< "$entry"
            if [[ ("$status" == "UPDATE" || "$status" == "CRITICAL") && "$auto" == "1" && "$cat" != "APT" && "$cat" != "Snap" ]]; then
                echo -e "  $action"
            fi
        done

        echo ""
    fi
}

# ══════════════════════════════════════════════════════════════════
# APPLY MODE: Sequential Safe Update
# ══════════════════════════════════════════════════════════════════
do_updates() {
    echo ""
    echo -e "${BOLD}${MAGENTA}╔══════════════════════════════════════════════╗${NC}"
    echo -e "${BOLD}${MAGENTA}║  🔧 Sequential Update Mode (Safe)            ║${NC}"
    echo -e "${BOLD}${MAGENTA}╚══════════════════════════════════════════════╝${NC}"
    echo ""

    # Collect updatable items
    local -a to_update=()
    for entry in "${RESULTS[@]}"; do
        IFS='|' read -r cat app cur latest status action auto <<< "$entry"
        if [[ ("$status" == "UPDATE" || "$status" == "CRITICAL") ]]; then
            to_update+=("$entry")
        fi
    done

    if (( ${#to_update[@]} == 0 )); then
        echo -e "  ${GREEN}Không có gì cần update!${NC}"
        return
    fi

    # Show update plan
    echo -e "  ${BOLD}Kế hoạch update (${#to_update[@]} phần mềm):${NC}"
    echo ""
    local idx=0
    for entry in "${to_update[@]}"; do
        ((idx++))
        IFS='|' read -r cat app cur latest status action auto <<< "$entry"
        local auto_label
        if [[ "$auto" == "1" && ! "$action" == MANUAL:* ]]; then
            auto_label="${GREEN}[Auto]${NC}"
        else
            auto_label="${YELLOW}[Thủ công]${NC}"
        fi
        echo -e "  ${BOLD}${idx}.${NC} ${app} ${DIM}(${cur} → ${latest})${NC} $auto_label"
    done
    echo ""

    # Confirm
    if [[ "$YES_MODE" == false && "$INTERACTIVE" == true ]]; then
        echo -ne "  ${BOLD}Bắt đầu update? [y/N]: ${NC}"
        read -r confirm
        if [[ ! "$confirm" =~ ^[yY] ]]; then
            echo -e "  ${DIM}Đã hủy.${NC}"
            return
        fi
    fi

    echo ""
    echo -e "  ${DIM}Log: ${UPDATE_LOG}${NC}"
    echo ""

    # ── Pre-authenticate sudo ─────────────────────────────────
    local needs_sudo=false
    for entry in "${to_update[@]}"; do
        [[ "$entry" == *"sudo "* ]] && needs_sudo=true && break
    done

    if [[ "$needs_sudo" == true ]]; then
        echo -e "  ${DIM}Một số update cần quyền sudo, xin nhập password trước...${NC}"
        if ! sudo -v; then
            echo -e "  ${RED}Không thể xác thực sudo. Hủy update.${NC}"
            return
        fi
        # Keep sudo session alive in background
        ( while true; do sudo -n -v 2>/dev/null; sleep 50; done ) &
        local SUDO_KEEPER_PID=$!
        trap "kill $SUDO_KEEPER_PID 2>/dev/null" RETURN
        echo -e "  ${GREEN}✓ Sudo authenticated${NC}"
        echo ""
    fi

    # Initialize update log
    {
        echo "# Update Log — $(date '+%d/%m/%Y %H:%M:%S')"
        echo ""
        echo "| # | App | Trước | Sau | Trạng thái | Thời gian | Ghi chú |"
        echo "|---|-----|-------|-----|------------|-----------|---------|"
    } > "$UPDATE_LOG"

    # Execute updates one by one
    idx=0
    for entry in "${to_update[@]}"; do
        ((idx++))
        IFS='|' read -r cat app cur latest status action auto <<< "$entry"

        echo -e "  ${BOLD}━━━ [$idx/${#to_update[@]}] ${app} ━━━${NC}"
        echo -e "  ${DIM}${cur} → ${latest}${NC}"

        # ── Skip manual updates ───────────────────────────────────
        if [[ "$action" == MANUAL:* || "$auto" != "1" ]]; then
            local manual_note="${action#MANUAL:}"
            echo -e "  ${YELLOW}⏭  Bỏ qua (cần update thủ công)${NC}"
            echo -e "  ${DIM}   → $manual_note${NC}"
            ((UPD_SKIP++))
            echo "| $idx | $app | \`$cur\` | — | ⏭ Skipped | — | Manual: $manual_note |" >> "$UPDATE_LOG"
            echo ""
            continue
        fi

        # ── Execute update ────────────────────────────────────────
        local upd_start upd_end upd_elapsed upd_exit new_ver
        upd_start=$(date +%s)

        echo -e "  ${CYAN}▶ Chạy: ${action}${NC}"
        echo ""

        # Run command with real-time output + logging
        local cmd_log_tmp="${UPDATE_LOG}.tmp_${idx}"
        {
            echo ""
            echo "---"
            echo "### [$idx] $app — $(date '+%H:%M:%S')"
            echo '```'
        } >> "$UPDATE_LOG"

        eval "$action" 2>&1 | tee -a "$UPDATE_LOG"
        upd_exit=${PIPESTATUS[0]}
        echo '```' >> "$UPDATE_LOG"

        upd_end=$(date +%s)
        upd_elapsed=$((upd_end - upd_start))

        # ── Verify new version ────────────────────────────────────
        new_ver=""
        case "$cat" in
            APT)
                local pkg
                pkg=$(echo "$action" | grep -oP 'install --only-upgrade \K\S+') || true
                [[ -n "$pkg" ]] && new_ver=$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null)
                ;;
            Snap)
                local pkg
                pkg=$(echo "$action" | awk '{print $NF}')
                new_ver=$(snap list "$pkg" 2>/dev/null | tail -1 | awk '{print $2}')
                ;;
            CLI)
                case "$app" in
                    "Claude Code") new_ver=$(claude --version 2>/dev/null | grep -oP '[\d.]+' | head -1) ;;
                    "Codex CLI")   new_ver=$(codex --version 2>/dev/null | grep -oP '[\d.]+' | head -1) ;;
                    "uv")          new_ver=$(uv --version 2>/dev/null | grep -oP '[\d.]+' | head -1) ;;
                esac
                ;;
            GitHub)
                local dpkg_name
                for gentry in "${TRACKED_GITHUB[@]}"; do
                    IFS='|' read -r _ dn _ _ _ <<< "$gentry"
                    if [[ "$gentry" == *"$app"* ]]; then
                        dpkg_name="$dn"
                        break
                    fi
                done
                [[ -n "${dpkg_name:-}" ]] && new_ver=$(dpkg-query -W -f='${Version}' "$dpkg_name" 2>/dev/null | grep -oP '^\d+\.\d+[\.\d]*')
                ;;
        esac

        # ── Evaluate result ───────────────────────────────────────
        if [[ $upd_exit -ne 0 ]]; then
            echo -e "  ${RED}✗ THẤT BẠI (exit code: $upd_exit) — ${upd_elapsed}s${NC}"
            ((UPD_FAIL++))
            echo "| $idx | $app | \`$cur\` | \`${new_ver:-?}\` | ❌ Failed | ${upd_elapsed}s | Exit: $upd_exit |" >> "$UPDATE_LOG"
        elif [[ -n "$new_ver" && "$new_ver" != "$cur" ]]; then
            echo -e "  ${GREEN}✓ THÀNH CÔNG: ${cur} → ${new_ver} — ${upd_elapsed}s${NC}"
            ((UPD_SUCCESS++))
            echo "| $idx | $app | \`$cur\` | \`$new_ver\` | ✅ OK | ${upd_elapsed}s | — |" >> "$UPDATE_LOG"
        elif [[ -n "$new_ver" && "$new_ver" == "$cur" ]]; then
            echo -e "  ${YELLOW}⚠ Version không đổi (${cur}) — có thể cần restart — ${upd_elapsed}s${NC}"
            ((UPD_SUCCESS++))
            echo "| $idx | $app | \`$cur\` | \`$new_ver\` | ⚠️ Same ver | ${upd_elapsed}s | Có thể cần restart |" >> "$UPDATE_LOG"
        else
            echo -e "  ${YELLOW}? Không xác nhận được version mới — ${upd_elapsed}s${NC}"
            ((UPD_SUCCESS++))
            echo "| $idx | $app | \`$cur\` | \`?\` | ❓ Unverified | ${upd_elapsed}s | Kiểm tra thủ công |" >> "$UPDATE_LOG"
        fi

        echo ""

        # Small delay between updates to avoid conflicts
        sleep 1
    done

    # ── Update summary ────────────────────────────────────────────
    echo -e "${BOLD}┌─ 📊 Kết quả Update ──────────────────────────────────────────────${NC}"
    echo -e "  ${GREEN}✓ Thành công: ${UPD_SUCCESS}${NC}    ${RED}✗ Thất bại: ${UPD_FAIL}${NC}    ${YELLOW}⏭ Bỏ qua: ${UPD_SKIP}${NC}"
    echo ""
    echo -e "  ${DIM}Chi tiết: ${UPDATE_LOG}${NC}"
    echo ""

    # Append summary to update log
    {
        echo ""
        echo "## Tổng kết"
        echo "- ✅ Thành công: $UPD_SUCCESS"
        echo "- ❌ Thất bại: $UPD_FAIL"
        echo "- ⏭ Bỏ qua (thủ công): $UPD_SKIP"
    } >> "$UPDATE_LOG"
}

# ══════════════════════════════════════════════════════════════════
# REPORT: Save Markdown Report
# ══════════════════════════════════════════════════════════════════
save_report() {
    {
        echo "# 🔄 Update Check Report — $(date '+%d/%m/%Y %H:%M')"
        echo ""
        echo "| Nguồn | Phần mềm | Hiện tại | Mới nhất | Trạng thái |"
        echo "|-------|----------|----------|----------|------------|"

        for entry in "${RESULTS[@]}"; do
            IFS='|' read -r cat app cur latest status action auto <<< "$entry"
            local badge
            case "$status" in
                OK)       badge="✅ OK" ;;
                UPDATE)   badge="⚠️ Update" ;;
                CRITICAL) badge="🔴 Critical" ;;
                *)        badge="ℹ️ Unknown" ;;
            esac
            echo "| $cat | **$app** | \`$cur\` | \`$latest\` | $badge |"
        done

        if (( CNT_DISCOVERED > 0 )); then
            echo ""
            echo "## 🆕 Phần mềm mới phát hiện"
            echo ""
            echo "| Nguồn | Package | Tên | Version |"
            echo "|-------|---------|-----|---------|"
            for d in "${DISCOVERED[@]}"; do
                IFS='|' read -r dcat dpkg dname dver <<< "$d"
                echo "| $dcat | $dpkg | $dname | $dver |"
            done
        fi

        echo ""
        echo "## Khuyến nghị"
        echo ""
        if (( ${#ACTIONS_HIGH[@]} > 0 )); then
            echo "### 🔴 Ưu tiên cao"
            for act in "${ACTIONS_HIGH[@]}"; do echo "- \`$act\`"; done
            echo ""
        fi
        if (( ${#ACTIONS_MED[@]} > 0 )); then
            echo "### ⚠️ Ưu tiên trung bình"
            for act in "${ACTIONS_MED[@]}"; do echo "- \`$act\`"; done
            echo ""
        fi
        if (( CNT_CRITICAL + CNT_UPDATE == 0 )); then
            echo "🎉 Tất cả phần mềm đều đã cập nhật!"
        fi
    } > "$REPORT_FILE"

    ln -sf "$REPORT_FILE" "$LATEST_REPORT"
}

# ══════════════════════════════════════════════════════════════════
# NOTIFICATION: Desktop notification for cron
# ══════════════════════════════════════════════════════════════════
send_notification() {
    if [[ "$INTERACTIVE" == false ]] && command -v notify-send &>/dev/null; then
        local title urgency
        if (( CNT_CRITICAL > 0 )); then
            title="🔴 ${CNT_CRITICAL} critical, ${CNT_UPDATE} updates"
            urgency="critical"
        elif (( CNT_UPDATE > 0 )); then
            title="⚠️ ${CNT_UPDATE} updates available"
            urgency="normal"
        else
            title="✅ All up to date!"
            urgency="low"
        fi
        [[ CNT_DISCOVERED -gt 0 ]] && title+=" | ${CNT_DISCOVERED} new apps"
        local body="OK:${CNT_OK} Update:${CNT_UPDATE} Critical:${CNT_CRITICAL}\nReport: ${LATEST_REPORT}"

        if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
            export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
        fi
        DISPLAY="${DISPLAY:-:0}" notify-send -u "$urgency" "Update Checker" "$title" 2>/dev/null || true
    fi
}

# ══════════════════════════════════════════════════════════════════
# JSON Output
# ══════════════════════════════════════════════════════════════════
print_json() {
    echo "{"
    echo "  \"timestamp\": \"$(date -Iseconds)\","
    echo "  \"summary\": {\"ok\":$CNT_OK,\"update\":$CNT_UPDATE,\"critical\":$CNT_CRITICAL,\"unknown\":$CNT_UNKNOWN,\"discovered\":$CNT_DISCOVERED},"
    echo "  \"results\": ["
    local first=true
    for entry in "${RESULTS[@]}"; do
        IFS='|' read -r cat app cur latest status action auto <<< "$entry"
        [[ "$first" == true ]] && first=false || echo ","
        echo -n "    {\"category\":\"$cat\",\"app\":\"$app\",\"current\":\"$cur\",\"latest\":\"$latest\",\"status\":\"$status\",\"auto\":$([[ "$auto" == "1" ]] && echo true || echo false)}"
    done
    echo ""
    echo "  ],"
    echo "  \"discovered\": ["
    first=true
    for d in "${DISCOVERED[@]+"${DISCOVERED[@]}"}"; do
        IFS='|' read -r dcat dpkg dname dver <<< "$d"
        [[ "$first" == true ]] && first=false || echo ","
        echo -n "    {\"category\":\"$dcat\",\"package\":\"$dpkg\",\"name\":\"$dname\",\"version\":\"$dver\"}"
    done
    echo ""
    echo "  ]"
    echo "}"
}

# ══════════════════════════════════════════════════════════════════
# MAIN
# ══════════════════════════════════════════════════════════════════
main() {
    local start_time
    start_time=$(date +%s)

    if [[ "$INTERACTIVE" == true && "$JSON_MODE" == false ]]; then
        echo ""
        echo -e "${BOLD}${MAGENTA}╔══════════════════════════════════════════════╗${NC}"
        echo -e "${BOLD}${MAGENTA}║   Software Update Checker v2                 ║${NC}"
        echo -e "${BOLD}${MAGENTA}║   Auto-discover · Safe sequential update     ║${NC}"
        echo -e "${BOLD}${MAGENTA}╚══════════════════════════════════════════════╝${NC}"
    fi

    # Run all checks
    check_apt
    check_snap
    check_github
    check_cli_tools
    discover_new_software

    local end_time elapsed
    end_time=$(date +%s)
    elapsed=$((end_time - start_time))

    # Output
    if [[ "$JSON_MODE" == true ]]; then
        print_json
    else
        print_table
        print_recommendations
        echo -e "  ${DIM}Hoàn thành trong ${elapsed}s · Report: ${LATEST_REPORT}${NC}"
        echo ""
    fi

    # Save report + notify
    save_report
    send_notification

    # Log
    echo "[$(date -Iseconds)] OK:$CNT_OK UPD:$CNT_UPDATE CRIT:$CNT_CRITICAL UNK:$CNT_UNKNOWN NEW:$CNT_DISCOVERED (${elapsed}s)" >> "$LOG_FILE"

    # Apply mode: run sequential updates
    if [[ "$APPLY_MODE" == true ]]; then
        do_updates
    fi

    # Exit code
    if (( CNT_CRITICAL > 0 )); then return 2
    elif (( CNT_UPDATE > 0 )); then return 1
    fi
    return 0
}

main
